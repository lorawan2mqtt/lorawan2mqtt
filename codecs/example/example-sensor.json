{
  "vendor": "example",
  "model": "Example Sensor",
  "name": "example-sensor",
  "description": "Fictional temperature/humidity/battery sensor showing the codec format",
  "spec": "temp:i16@0/10#°C hum:u8@2#% bat:u16@3/1000#V",
  "tests": [
    {
      "fport": 2,
      "payload": "00F1480BB8",
      "expect": { "temp": 24.1, "hum": 72, "bat": 3.0 }
    },
    {
      "fport": 2,
      "payload": "FF38240C1C",
      "expect": { "temp": -20.0, "hum": 36, "bat": 3.1 }
    }
  ],
  "source": "https://github.com/Di-Ny/lorawan2mqtt/blob/main/codecs/README.md",
  "contributors": ["Di-Ny"]
}
